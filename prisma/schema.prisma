generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String          @id @default(cuid())
  name              String?
  username          String?         @unique
  email             String?         @unique
  emailVerified     DateTime?
  image             String?
  role              String          @default("USER")
  balance           Decimal         @default(1000.00)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  accounts          Account[]
  lmsrSnapshots     LmsrSnapshot[]
  comments          MarketComment[]
  currentPositions  Position[]      @relation("CurrentOwner")
  originalPositions Position[]      @relation("OriginalOwner")
  sessions          Session[]
  transactions      Transaction[]

  @@index([username])
}

model Market {
  id                      String          @id @default(cuid())
  playerName              String?
  question                String
  description             String?
  status                  String          @default("DRAFT")
  winningOutcomeId        String?
  b                       Float           @default(100.0)
  alpha                   Float?
  bMin                    Float?
  seedCost                Float           @default(0)
  totalPool               Decimal         @default(0)
  maxPool                 Decimal?
  platformFee             Decimal         @default(0.015)
  resolutionDate          DateTime
  resolvedAt              DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  sport                   String?         @default("futbol")
  maxBetAmount            Float?
  maxPriceImpact          Float?
  primaryMarketPaused     Boolean         @default(false)
  primaryPauseScheduledAt DateTime?
  bannerUrl               String?
  criterio                String?
  imageUrl                String?
  isFeatured              Boolean         @default(false)
  rules                   String?
  tags                    String[]
  lmsrSnapshots           LmsrSnapshot[]
  comments                MarketComment[]
  history                 MarketHistory[]
  outcomes                MarketOutcome[]
  positions               Position[]

  @@index([status])
  @@index([resolutionDate])
}

model Position {
  id                 String        @id @default(cuid())
  marketId           String
  outcomeId          String
  originalOwnerId    String
  currentOwnerId     String
  side               String
  amount             Decimal
  status             String        @default("ACTIVE")
  payout             Decimal?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  shares             Float         @default(0)
  avgCostPerShare    Float         @default(0)
  totalCost          Float         @default(0)
  initialProbability Decimal       @default(0)
  purchasePrice      Decimal       @default(0)
  currentOwner       User          @relation("CurrentOwner", fields: [currentOwnerId], references: [id])
  market             Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  originalOwner      User          @relation("OriginalOwner", fields: [originalOwnerId], references: [id])
  outcome            MarketOutcome @relation(fields: [outcomeId], references: [id])

  @@index([marketId])
  @@index([currentOwnerId])
  @@index([status])
  @@index([outcomeId])
}

model LmsrSnapshot {
  id          String   @id @default(cuid())
  marketId    String
  outcomeId   String?
  qBefore     Json
  pBefore     Json
  side        String
  deltaShares Float
  cost        Float
  qAfter      Json
  pAfter      Json
  triggerType String
  userId      String?
  createdAt   DateTime @default(now())
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@index([marketId])
  @@index([createdAt])
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  type          String
  amount        Decimal
  balanceBefore Decimal
  balanceAfter  Decimal
  reference     String?
  description   String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model MarketHistory {
  id        String   @id @default(cuid())
  marketId  String
  odds      Json
  totalPool Decimal
  createdAt DateTime @default(now())
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId])
  @@index([createdAt])
}

model PlatformConfig {
  id               String @id @default("global")
  defaultMaxBet    Float  @default(500)
  defaultMaxImpact Float  @default(5.0)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MarketComment {
  id        String   @id @default(cuid())
  marketId  String
  userId    String
  content   String
  createdAt DateTime @default(now())
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([marketId, createdAt])
}

model MarketOutcome {
  id           String     @id @default(cuid())
  marketId     String
  name         String
  color        String?
  qOutstanding Float      @default(0)
  pool         Decimal    @default(0)
  displayOrder Int        @default(0)
  market       Market     @relation(fields: [marketId], references: [id], onDelete: Cascade)
  positions    Position[]

  @@unique([marketId, name])
  @@index([marketId])
}
